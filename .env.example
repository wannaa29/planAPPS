DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=wann-dev.my.id,www.wann-dev.my.id,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://wann-dev.my.id,https://www.wann-dev.my.id,http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=1

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=workflow_planner
DB_USER=workflow_planner
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
